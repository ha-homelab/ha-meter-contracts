include README*.md LICENSE CONTRIBUTING.md SECURITY.md CHANGELOG.md version schema.json
recursive-include docs *.md *.svg
recursive-include examples *.json *.yaml
recursive-include scripts *.py
recursive-include tests *.py
recursive-include wiki *.md
recursive-include src *.py *.typed *.json

include GOVERNANCE.md CODE_OF_CONDUCT.md ROADMAP.md RELEASING.md
recursive-include tools *.py
include requirements-ci.in requirements-ci.txt

# Inputs referenced by the release guide and multilingual documentation checks.
include .github/workflows/check.yml docs/languages.json docs/translations.json
